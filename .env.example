NEXT_PUBLIC_SUPABASE_URL=https://ysffyuohwvdifvbopfcm.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Phase 4 — RAG / embeddings
# Anthropic has no embeddings endpoint (Claude models are not embedding
# models) — see src/lib/embeddingPipeline.ts's header comment. Set ONE of
# these two to use a real embedding provider; if neither is set, a
# deterministic local pseudo-embedding is used (dev/test only, NOT
# semantically meaningful — logs a warning). OPENAI_API_KEY is the
# recommended default: text-embedding-3-small natively returns 1536-dim
# vectors, an exact match for the research_chunks.embedding column.
OPENAI_API_KEY=
VOYAGE_API_KEY=

# Overrides the default Sonnet model id used for research relevance scoring
# (src/lib/researchScoring.ts). Confirm against the live Anthropic model list.
ANTHROPIC_SONNET_MODEL=claude-sonnet-4-5-20250929

# Shared-secret gate for POST /api/research/ingest (Phase 4 admin endpoint).
# Also reused (per Part B item 4's instruction) to gate Phase 5's
# /api/ingredients/review, /api/ingredients/review-queue, and
# /api/ingredients/photo-url admin endpoints. This is a stopgap, not a real
# admin auth system — see those routes' header comments and BUILD_PROGRESS.md.
RESEARCH_INGEST_ADMIN_TOKEN=

# Phase 5 — Photo/OCR ingestion
# Overrides the default Haiku model id used for ingredient photo vision/OCR
# extraction (src/lib/ingredientOcr.ts). Confirm against the live Anthropic
# model list before relying on the default in production.
ANTHROPIC_HAIKU_MODEL=claude-haiku-4-5-20251001

# Phase 6 — Cron job auth (weekly food discovery, daily correlation engine,
# daily inactivity check — see vercel.json). Vercel Cron automatically sends
# `Authorization: Bearer $CRON_SECRET` when this is set. The routes also
# accept the existing RESEARCH_INGEST_ADMIN_TOKEN via x-admin-token for
# manual/local testing (src/lib/cronAuth.ts) — a stopgap, same category as
# every other admin-token gate in this codebase (see BUILD_PROGRESS.md).
CRON_SECRET=
