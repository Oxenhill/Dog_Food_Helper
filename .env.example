NEXT_PUBLIC_SUPABASE_URL=https://ysffyuohwvdifvbopfcm.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Anthropic Message Batches API (src/lib/batchApiHelper.ts, weekly food
# discovery job only). This is the ONE call path that stays direct-to-Anthropic
# rather than routing through the Gateway — Vercel AI Gateway has no batch/
# async-discount equivalent as of this session's research, so the 50%
# batch-discount job keeps its own key. Everything else (OCR, research
# scoring, embeddings) now goes through the Gateway instead — see below.
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# Raw Anthropic API model id (NOT a Gateway "provider/model" id) used only by
# the direct Batch API call above. Confirm against the live Anthropic model
# list before relying on the default in production.
ANTHROPIC_HAIKU_MODEL=claude-haiku-4-5-20251001

# Vercel AI Gateway (this session) — replaces direct Anthropic/OpenAI/Voyage
# calls in src/lib/ingredientOcr.ts, researchScoring.ts, embeddingPipeline.ts.
# On Vercel, auth is automatic via the project's OIDC token (VERCEL_OIDC_TOKEN)
# once "OIDC Federation" is enabled for the project in Vercel's project
# settings — no key needed there. Locally (or if OIDC isn't enabled), set
# AI_GATEWAY_API_KEY instead (create one via `vercel ai-gateway api-keys create`
# or the Vercel dashboard). If neither is present: OCR/research-scoring calls
# will fail outright, and embeddings silently fall back to a non-semantic
# local pseudo-embedding in dev (blocked outright in production — see
# src/lib/embeddingPipeline.ts).
AI_GATEWAY_API_KEY=

# Model ids below are Gateway "provider/model" strings, confirmed live
# against https://ai-gateway.vercel.sh/v1/models (no auth required to check)
# — these exact ids matched CLAUDE.md's product names verbatim, resolving
# the "exact model-id unconfirmed" flag carried since Phase 4/5.
AI_GATEWAY_HAIKU_MODEL=anthropic/claude-haiku-4.5
AI_GATEWAY_SONNET_MODEL=anthropic/claude-sonnet-5
# Embedding provider/model choice remains owner-approval-gated per CLAUDE.md
# (embedding provider/model/dimension) — this default just continues Phase
# 4's placeholder pick (native 1536-dim, exact match for the
# research_chunks.embedding column) under Gateway routing instead of a
# direct OpenAI call. Swap to e.g. voyage/voyage-3-large to change provider.
AI_GATEWAY_EMBEDDING_MODEL=openai/text-embedding-3-small

# Real admin auth (replaces the old RESEARCH_INGEST_ADMIN_TOKEN shared-secret
# stopgap). Admin routes (/api/research/ingest, /api/ingredients/review,
# /api/ingredients/review-queue, /api/ingredients/photo-url, and manual
# triggering of the /api/cron/* routes) now require a real Supabase session
# whose user_profiles.is_admin = true (src/lib/serverAdminAuth.ts).
#
# ADMIN_EMAILS: comma-separated list of emails that are auto-granted
# is_admin=true the moment they sign up via POST /api/auth/signup (see that
# route). Set this to your own email BEFORE signing up to become the first
# admin, e.g. ADMIN_EMAILS=trainers@dogsmarttrainingbehaviour.co.uk — without
# this, no account is an admin and you'd need a manual
# `UPDATE user_profiles SET is_admin = true WHERE id = '<your-user-id>'` instead.
ADMIN_EMAILS=

# Phase 6 — Cron job auth (weekly food discovery, daily correlation engine,
# daily inactivity check — see vercel.json). Vercel Cron automatically sends
# `Authorization: Bearer $CRON_SECRET` when this is set. The routes also
# accept a real admin session bearer token for manual/local triggering
# (src/lib/cronAuth.ts + serverAdminAuth.ts) — same admin check as above, not
# a shared secret.
CRON_SECRET=

# Inactivity-warning email delivery (src/lib/emailProvider.ts, Resend REST
# API). Both must be set for the daily inactivity-check cron job to actually
# deliver a warning before deletion — if either is missing, the warning is
# logged only (not delivered) and inactivity_warning_sent_at is deliberately
# left unset so the user isn't deleted without ever being told. EMAIL_FROM_ADDRESS
# must be a sender address verified with your Resend account/domain.
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=

# Contributor access for the /contribute path (src/lib/contributorAuth.ts).
# ONE shared token for every contributor, by owner decision (2026-07-26) — the
# contributors are non-technical friends donating their own AI-subscription
# usage, so per-person accounts would be ceremony with no security gain. The
# link handed out is https://<host>/contribute?key=<this value>.
#
# What the token permits, deliberately: render the contribute page, and POST a
# submission into `contributed_foods`, which nothing reads until an admin
# approves it in /admin/contributions. It grants no read access to users, dogs,
# logs or research and cannot modify anything that already exists — so a
# forwarded or leaked link is a spammed review queue, not an incident.
#
# UNSET MEANS CLOSED: with no value, /contribute and the write path both 404.
# Rotate by changing this value; old links stop working immediately.
CONTRIBUTOR_TOKEN=
