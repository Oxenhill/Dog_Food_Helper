NEXT_PUBLIC_SUPABASE_URL=https://ysffyuohwvdifvbopfcm.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Phase 4 — RAG / embeddings
# Anthropic has no embeddings endpoint (Claude models are not embedding
# models) — see src/lib/embeddingPipeline.ts's header comment. Set ONE of
# these two to use a real embedding provider; if neither is set, a
# deterministic local pseudo-embedding is used (dev/test only, NOT
# semantically meaningful — logs a warning). OPENAI_API_KEY is the
# recommended default: text-embedding-3-small natively returns 1536-dim
# vectors, an exact match for the research_chunks.embedding column.
OPENAI_API_KEY=
VOYAGE_API_KEY=

# Overrides the default Sonnet model id used for research relevance scoring
# (src/lib/researchScoring.ts). Confirm against the live Anthropic model list.
ANTHROPIC_SONNET_MODEL=claude-sonnet-4-5-20250929

# Real admin auth (replaces the old RESEARCH_INGEST_ADMIN_TOKEN shared-secret
# stopgap). Admin routes (/api/research/ingest, /api/ingredients/review,
# /api/ingredients/review-queue, /api/ingredients/photo-url, and manual
# triggering of the /api/cron/* routes) now require a real Supabase session
# whose user_profiles.is_admin = true (src/lib/serverAdminAuth.ts).
#
# ADMIN_EMAILS: comma-separated list of emails that are auto-granted
# is_admin=true the moment they sign up via POST /api/auth/signup (see that
# route). Set this to your own email BEFORE signing up to become the first
# admin, e.g. ADMIN_EMAILS=trainers@dogsmarttrainingbehaviour.co.uk — without
# this, no account is an admin and you'd need a manual
# `UPDATE user_profiles SET is_admin = true WHERE id = '<your-user-id>'` instead.
ADMIN_EMAILS=

# Phase 5 — Photo/OCR ingestion
# Overrides the default Haiku model id used for ingredient photo vision/OCR
# extraction (src/lib/ingredientOcr.ts). Confirm against the live Anthropic
# model list before relying on the default in production.
ANTHROPIC_HAIKU_MODEL=claude-haiku-4-5-20251001

# Phase 6 — Cron job auth (weekly food discovery, daily correlation engine,
# daily inactivity check — see vercel.json). Vercel Cron automatically sends
# `Authorization: Bearer $CRON_SECRET` when this is set. The routes also
# accept a real admin session bearer token for manual/local triggering
# (src/lib/cronAuth.ts + serverAdminAuth.ts) — same admin check as above, not
# a shared secret.
CRON_SECRET=

# Inactivity-warning email delivery (src/lib/emailProvider.ts, Resend REST
# API). Both must be set for the daily inactivity-check cron job to actually
# deliver a warning before deletion — if either is missing, the warning is
# logged only (not delivered) and inactivity_warning_sent_at is deliberately
# left unset so the user isn't deleted without ever being told. EMAIL_FROM_ADDRESS
# must be a sender address verified with your Resend account/domain.
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=
